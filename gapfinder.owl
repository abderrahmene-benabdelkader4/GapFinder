<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://gapfinder.example.org/onto"
         xmlns="http://gapfinder.example.org/onto#">

<owl:Ontology rdf:about="http://gapfinder.example.org/onto"/>

<owl:ObjectProperty rdf:about="#addresses">
  <rdfs:domain rdf:resource="#Paper"/>
  <rdfs:range rdf:resource="#Problem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper tackles this problem.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ADDRESSES</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#uses">
  <rdfs:domain rdf:resource="#Paper"/>
  <rdfs:range rdf:resource="#Method"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper uses/proposes this method (edge property role: proposed|baseline|used).</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USES</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesDataset">
  <rdfs:domain rdf:resource="#Paper"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper uses this dataset.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USES_DATASET</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#studies">
  <rdfs:domain rdf:resource="#Paper"/>
  <rdfs:range rdf:resource="#Context"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper studies this language/population/domain.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STUDIES</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#appliedTo">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Problem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A method applied to a problem. In Neo4j each edge carries the source paper, page and passage.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">APPLIED_TO</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#evaluatedOn">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A method evaluated on a dataset (edge carries paper, page, passage).</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EVALUATED_ON</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reports">
  <rdfs:domain rdf:resource="#Paper"/>
  <rdfs:range rdf:resource="#Result"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper reports this result.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">REPORTS</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ofMethod">
  <rdfs:domain rdf:resource="#Result"/>
  <rdfs:range rdf:resource="#Method"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The method the result was obtained with.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OF_METHOD</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#onDataset">
  <rdfs:domain rdf:resource="#Result"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The dataset the result was measured on.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ON_DATASET</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#measuredBy">
  <rdfs:domain rdf:resource="#Result"/>
  <rdfs:range rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The metric of the result.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEASURED_BY</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#states">
  <rdfs:domain rdf:resource="#Paper"/>
  <rdfs:range rdf:resource="#Limitation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper states this limitation.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STATES</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#suggests">
  <rdfs:domain rdf:resource="#Paper"/>
  <rdfs:range rdf:resource="#FutureWork"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper suggests this future work.</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SUGGESTS</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mentions">
  <rdfs:domain rdf:resource="#FutureWork"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Problem"/>
        <rdf:Description rdf:about="#Method"/>
        <rdf:Description rdf:about="#Dataset"/>
        <rdf:Description rdf:about="#Context"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Entities named in a future-work statement (a Method, Problem, Context or Dataset).</rdfs:comment>
  <neo4jRelationshipType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MENTIONS</neo4jRelationshipType>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#paperId">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Paper"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">File-stem identifier of the paper (Neo4j property id).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#title">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Paper"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paper title.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#name">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Problem"/>
        <rdf:Description rdf:about="#Method"/>
        <rdf:Description rdf:about="#Dataset"/>
        <rdf:Description rdf:about="#Metric"/>
        <rdf:Description rdf:about="#Context"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Canonical name of an entity after normalization.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#value">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Result"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The reported number (e.g. 22.4).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#resultContext">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Result"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Context of the result (Neo4j property context), e.g. the language.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#text">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Limitation"/>
        <rdf:Description rdf:about="#FutureWork"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normalized statement text.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#page">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Page of the supporting passage. In Neo4j this lives on the RELATIONSHIP (provenance); OWL would need reification to attach it to an edge.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#passage">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verbatim sentence from the paper that supports the fact. In Neo4j this lives on the RELATIONSHIP (provenance); OWL would need reification to attach it to an edge.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#role">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proposed | baseline | used In Neo4j this lives on the RELATIONSHIP (provenance); OWL would need reification to attach it to an edge.</rdfs:comment>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="#neo4jRelationshipType"/>

<owl:AnnotationProperty rdf:about="#altLabel"/>

<owl:Class rdf:about="#Paper">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A scientific paper in the project corpus (Neo4j label Paper).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Problem">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A research problem or task a paper addresses, e.g. 'low-resource machine translation'.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Method">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A technique, model or approach, e.g. mBART, LoRA, back-translation.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Dataset">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dataset or benchmark, e.g. FLORES-200.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Metric">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An evaluation measure, e.g. BLEU, chrF.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Result">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One reported number: a method evaluated on a dataset with a metric, in a context. Kept as its own node so the score never loses its setting.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Limitation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A limitation explicitly stated by the authors.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FutureWork">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A future-work statement made by the authors.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Context">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The setting studied: a language, population or domain (merges the plan's 'Population / Context').</rdfs:comment>
</owl:Class>

<owl:NamedIndividual rdf:about="#mBART">
  <rdf:type rdf:resource="#Method"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mBART</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mbart-large</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">multilingual BART</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mbart-large-cc25</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#back_translation">
  <rdf:type rdf:resource="#Method"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">back-translation</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BT</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">backtranslation</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">back translation</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LoRA">
  <rdf:type rdf:resource="#Method"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LoRA</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low-rank adapters</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LoRA adapter</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low-rank adaptation</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LoRA adapters</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Transformer">
  <rdf:type rdf:resource="#Method"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vanilla Transformer</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer baseline</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#low_resource_machine_translation">
  <rdf:type rdf:resource="#Problem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low-resource machine translation</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low-resource MT</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LRMT</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low resource machine translation</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#dialect_translation">
  <rdf:type rdf:resource="#Problem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dialect translation</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">translation of dialects</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dialect machine translation</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dialect MT</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dialectal translation</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#domain_adaptation">
  <rdf:type rdf:resource="#Problem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domain adaptation</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domain adaptation for machine translation</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domain adaptation in MT</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domain-specific translation</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FLORES_200">
  <rdf:type rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FLORES-200</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FLORES200</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FLORES</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FLORES-200 dataset</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#OPUS_100">
  <rdf:type rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OPUS-100</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OPUS</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OPUS100</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MADAR">
  <rdf:type rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MADAR</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MADAR dataset</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BLEU">
  <rdf:type rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BLEU</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sacreBLEU</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BLEU score</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#chrF">
  <rdf:type rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chrF</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chrF++</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chrf</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Algerian_Arabic">
  <rdf:type rdf:resource="#Context"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Algerian Arabic</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Algerian Arabic (Darija)</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Darija</altLabel>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Algerian dialect</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Swahili">
  <rdf:type rdf:resource="#Context"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Swahili</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kiswahili</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Yoruba">
  <rdf:type rdf:resource="#Context"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yoruba</rdfs:label>
  <altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yoruba language</altLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Amharic">
  <rdf:type rdf:resource="#Context"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amharic</rdfs:label>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Paper"/>
    <rdf:Description rdf:about="#Problem"/>
    <rdf:Description rdf:about="#Method"/>
    <rdf:Description rdf:about="#Dataset"/>
    <rdf:Description rdf:about="#Metric"/>
    <rdf:Description rdf:about="#Result"/>
    <rdf:Description rdf:about="#Limitation"/>
    <rdf:Description rdf:about="#FutureWork"/>
    <rdf:Description rdf:about="#Context"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
